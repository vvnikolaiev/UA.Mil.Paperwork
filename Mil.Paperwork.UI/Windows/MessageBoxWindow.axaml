<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d"
		x:Class="Mil.Paperwork.UI.Windows.MessageBoxWindow"
		xmlns:vm="using:Mil.Paperwork.UI.ViewModels.Controls"
		xmlns:converters="using:Mil.Paperwork.UI.Converters"
		xmlns:enums="clr-namespace:Mil.Paperwork.Infrastructure.Enums;assembly=Mil.Paperwork.Infrastructure"
		Width="420"
		MinHeight="150"
		SizeToContent="Height"
		CanResize="False"
		WindowStartupLocation="CenterOwner"
		x:DataType="vm:MessageBoxViewModel"
		Title="{Binding Title}">

	<Window.Resources>
		<converters:InversedBoolConverter x:Key="InversedBoolConverter" />
		<converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
	</Window.Resources>

	<Grid Margin="16">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Coloured badge (collapsed when DialogIcon.None) -->
		<Border Grid.Row="0" Grid.Column="0"
				CornerRadius="8" Width="44" Height="44"
				Margin="0,0,14,0"
				VerticalAlignment="Top"
				IsVisible="{Binding HasIcon}"
				Classes.Information="{Binding Icon, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static enums:DialogIcon.Information}}"
				Classes.Warning="{Binding Icon, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static enums:DialogIcon.Warning}}"
				Classes.Error="{Binding Icon, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static enums:DialogIcon.Error}}"
				Classes.Question="{Binding Icon, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static enums:DialogIcon.Question}}">
			<Border.Styles>
				<Style Selector="Border.Information">
					<Setter Property="Background" Value="{DynamicResource NotificationCardInformationBackgroundBrush}"/>
				</Style>
				<Style Selector="Border.Warning">
					<Setter Property="Background" Value="{DynamicResource NotificationCardWarningBackgroundBrush}"/>
				</Style>
				<Style Selector="Border.Error">
					<Setter Property="Background" Value="{DynamicResource NotificationCardErrorBackgroundBrush}"/>
				</Style>
				<Style Selector="Border.Question">
					<Setter Property="Background" Value="{DynamicResource NotificationCardInformationBackgroundBrush}"/>
				</Style>
			</Border.Styles>

			<PathIcon Width="20" Height="20"
					  HorizontalAlignment="Center" VerticalAlignment="Center"
					  Data="{Binding IconKey, Converter={StaticResource ResourceKeyToGeometryConverter}}"
					  Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
		</Border>

		<!-- Title + message -->
		<StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
			<TextBlock Text="{Binding Title}"
					   FontWeight="SemiBold" FontSize="15"
					   IsVisible="{Binding IsTitleEmpty, Converter={StaticResource InversedBoolConverter}}"/>
			<TextBlock Text="{Binding Message}"
					   TextWrapping="Wrap"
					   Margin="0,6,0,0" />
		</StackPanel>

		<!-- Buttons -->
		<StackPanel Grid.Row="1" Grid.ColumnSpan="2"
					Orientation="Horizontal" HorizontalAlignment="Right"
					Spacing="8" Margin="0,14,0,0">

			<Button Content="{Binding OkText}"
					Classes="accent"
					IsVisible="{Binding IsOkVisible}"
					Command="{Binding OkCommand}"
					MinWidth="90"
					IsDefault="True"
					AutomationProperties.AutomationId="MessageBox_OkButton" />

			<Button Content="{Binding YesText}"
					Classes="accent"
					IsVisible="{Binding IsYesVisible}"
					Command="{Binding YesCommand}"
					MinWidth="90"
					IsDefault="{Binding IsOkVisible, Converter={StaticResource InversedBoolConverter}}"
					AutomationProperties.AutomationId="MessageBox_YesButton"/>

			<Button Content="{Binding NoText}"
					IsVisible="{Binding IsNoVisible}"
					Command="{Binding NoCommand}"
					MinWidth="90"
					IsCancel="{Binding IsCancelVisible, Converter={StaticResource InversedBoolConverter}}"
					AutomationProperties.AutomationId="MessageBox_NoButton" />

			<Button Content="{Binding CancelText}"
					IsVisible="{Binding IsCancelVisible}"
					Command="{Binding CancelCommand}"
					MinWidth="90"
					IsCancel="True"
					AutomationProperties.AutomationId="MessageBox_CancelButton" />

		</StackPanel>
	</Grid>
</Window>
