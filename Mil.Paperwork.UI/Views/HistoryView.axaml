<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="450"
			 x:Class="Mil.Paperwork.UI.Views.HistoryView"
			 xmlns:tabs="using:Mil.Paperwork.UI.ViewModels.Tabs"
			 xmlns:history="using:Mil.Paperwork.UI.ViewModels.History"
			 x:DataType="tabs:HistoryViewModel"
			 x:Name="Root">
	<DockPanel>
		<StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="5"
					Classes="parameters">
			<ComboBox ItemsSource="{Binding TypeFilters}"
					  SelectedItem="{Binding SelectedTypeFilter}"
					  DisplayMemberBinding="{Binding Text, DataType={x:Type history:HistoryTypeFilterItem}}"
					  VerticalAlignment="Center"
					  Width="220" Margin="0,0,5,0"/>

			<CalendarDatePicker SelectedDate="{Binding DateFrom}"
								PlaceholderText="Від"
								Width="140" Margin="0,0,5,0"/>

			<CalendarDatePicker SelectedDate="{Binding DateTo}"
								PlaceholderText="До"
								Width="140" Margin="0,0,5,0"/>

			<TextBox Text="{Binding SearchText, Mode=TwoWay}"
					 PlaceholderText="Пошук…"
					 Width="220" Margin="0,0,5,0"/>

			<Button Content="Очистити" Command="{Binding ClearFiltersCommand}" Margin="0,0,5,0"/>

			<Button Content="Оновити" Command="{Binding RefreshCommand}" Margin="0,0,5,0"/>

			<Button Content="Закрити" Command="{Binding CloseTabCommand}" Margin="0,0,5,0"/>
		</StackPanel>

		<DataGrid x:Name="HistoryGrid"
				  ItemsSource="{Binding Entries}"
				  SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
				  AutoGenerateColumns="False" Margin="5"
				  IsReadOnly="True"
				  CanUserSortColumns="True"
				  DoubleTapped="OnGridDoubleTapped"
				  KeyDown="OnGridKeyDown"
				  Sorting="OnGridSorting">
			<DataGrid.ContextMenu>
				<ContextMenu>
					<MenuItem Header="Відкрити"
							  Command="{Binding #Root.DataContext.OpenEntryCommand}"
							  CommandParameter="{Binding #Root.DataContext.SelectedEntry}"/>
					<MenuItem Header="Відкрити файл"
							  Command="{Binding #Root.DataContext.OpenGeneratedFileCommand}"
							  CommandParameter="{Binding #Root.DataContext.SelectedEntry}"
							  IsVisible="{Binding #Root.DataContext.SelectedEntry.HasGeneratedFiles}"/>
					<MenuItem Header="Видалити"
							  Command="{Binding #Root.DataContext.RemoveEntryCommand}"
							  CommandParameter="{Binding #Root.DataContext.SelectedEntry}"/>
					<Separator IsVisible="{Binding #Root.DataContext.SelectedEntry.HasCreateTargets}"/>
					<MenuItem Header="Створити…"
							  ItemsSource="{Binding #Root.DataContext.SelectedEntry.CreateTargets}"
							  IsVisible="{Binding #Root.DataContext.SelectedEntry.HasCreateTargets}">
						<MenuItem.ItemContainerTheme>
							<ControlTheme TargetType="MenuItem"
										  BasedOn="{StaticResource {x:Type MenuItem}}"
										  x:DataType="history:CreateFromTargetItem">
								<Setter Property="Header" Value="{Binding Text}"/>
								<Setter Property="Command" Value="{Binding Command}"/>
							</ControlTheme>
						</MenuItem.ItemContainerTheme>
					</MenuItem>
				</ContextMenu>
			</DataGrid.ContextMenu>

			<DataGrid.Styles>
				<Style Selector="Ellipse.draft">
					<Setter Property="Fill" Value="{DynamicResource BrushStatusDraft}"/>
				</Style>
				<Style Selector="Ellipse.generated">
					<Setter Property="Fill" Value="{DynamicResource BrushStatusGenerated}"/>
				</Style>
			</DataGrid.Styles>

			<DataGrid.Columns>
				<DataGridTemplateColumn Width="40" CanUserResize="False" CanUserSort="False">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="history:HistoryEntryViewModel">
							<Ellipse Width="10" Height="10"
									 HorizontalAlignment="Center"
									 VerticalAlignment="Center"
									 Classes.draft="{Binding IsDraft}"
									 Classes.generated="{Binding IsGenerated}"
									 ToolTip.Tip="{Binding StatusText}"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTextColumn Header="Тип" Binding="{Binding TypeText}"
									SortMemberPath="TypeText"
									CellStyleClasses="name"
									Width="190"/>

				<DataGridTextColumn Header="Дата" Binding="{Binding ModifiedAt, StringFormat='dd.MM.yyyy HH:mm'}"
									SortMemberPath="ModifiedAt"
									Width="140"/>

				<DataGridTextColumn Header="Документ" Binding="{Binding NumberSummaryText}"
									SortMemberPath="NumberSummaryText"
									CellStyleClasses="name"
									Width="*"/>

				<DataGridTemplateColumn Header="Файл" SortMemberPath="FileName" Width="200">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="history:HistoryEntryViewModel">
							<TextBlock Text="{Binding FileName}"
									   ToolTip.Tip="{Binding FilePath}"
									   VerticalAlignment="Center"
									   Margin="5,0"
									   TextTrimming="CharacterEllipsis"
									   DoubleTapped="OnFileNameDoubleTapped"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn Width="60" CanUserResize="False" CanUserSort="False">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="history:HistoryEntryViewModel">
							<Button Content="⋯"
									HorizontalAlignment="Center"
									VerticalAlignment="Center">
								<Button.Flyout>
									<MenuFlyout>
										<MenuItem Header="Відкрити"
												  Command="{Binding #Root.DataContext.OpenEntryCommand}"
												  CommandParameter="{Binding}"/>
										<MenuItem Header="Відкрити файл"
												  Command="{Binding #Root.DataContext.OpenGeneratedFileCommand}"
												  CommandParameter="{Binding}"
												  IsVisible="{Binding HasGeneratedFiles}"/>
										<MenuItem Header="Видалити"
												  Command="{Binding #Root.DataContext.RemoveEntryCommand}"
												  CommandParameter="{Binding}"/>
										<Separator IsVisible="{Binding HasCreateTargets}"/>
										<MenuItem Header="Створити…"
												  ItemsSource="{Binding CreateTargets}"
												  IsVisible="{Binding HasCreateTargets}">
											<MenuItem.ItemContainerTheme>
												<ControlTheme TargetType="MenuItem"
																  BasedOn="{StaticResource {x:Type MenuItem}}"
																  x:DataType="history:CreateFromTargetItem">
													<Setter Property="Header" Value="{Binding Text}"/>
													<Setter Property="Command" Value="{Binding Command}"/>
												</ControlTheme>
											</MenuItem.ItemContainerTheme>
										</MenuItem>
									</MenuFlyout>
								</Button.Flyout>
							</Button>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>
	</DockPanel>
</UserControl>
