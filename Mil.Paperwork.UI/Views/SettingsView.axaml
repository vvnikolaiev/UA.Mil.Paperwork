<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="300"
             x:Class="Mil.Paperwork.UI.Views.SettingsView"
             xmlns:viewModels="clr-namespace:Mil.Paperwork.UI.ViewModels.Tabs"
             x:DataType="viewModels:SettingsViewModel">

    <StackPanel Spacing="12" Margin="16" Classes="parameters">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="Тип майна за замовчуванням:" VerticalAlignment="Center" />
            <ComboBox Classes="enum"
                      ItemsSource="{Binding AssetTypes}"
                      SelectedItem="{Binding SelectedAssetType}"
                      MinWidth="200" />
        </StackPanel>
    </StackPanel>

</UserControl>
