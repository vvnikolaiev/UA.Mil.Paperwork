<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════
         THEME PALETTE COLORS
         Referenced by ColorPaletteResources in App.axaml via
         StaticResource — they MUST stay flat (not theme-scoped),
         App.axaml resolves them once at parse time.
    ═══════════════════════════════════════════════════════════ -->

    <!-- Shared teal accent (same in Light and Dark) -->
    <Color x:Key="ThemeAccent">#ff0f766e</Color>

    <!-- Light palette neutral scale (darkest → lightest) -->
    <Color x:Key="ThemeLightBaseMediumHigh">#ff3d3d3d</Color>
    <Color x:Key="ThemeLightBaseMediumLow">#ff6e6e6e</Color>
    <Color x:Key="ThemeLightBaseMedium">#ff8a8a8a</Color>
    <Color x:Key="ThemeLightBaseLow">#ffd1d1d1</Color>
    <Color x:Key="ThemeLightChromeMedium">#ffe6e6e6</Color>
    <Color x:Key="ThemeLightChromeLow">#fff0f0f0</Color>
    <Color x:Key="ThemeLightRegionColor">#fffafafa</Color>

    <!-- Dark palette neutral scale (darkest → lightest) -->
    <Color x:Key="ThemeDarkChromeLow">#ff1f1f1f</Color>
    <Color x:Key="ThemeDarkChromeMedium">#ff2b2b2b</Color>
    <Color x:Key="ThemeDarkChromeMediumLow">#ff3d3d3d</Color>
    <Color x:Key="ThemeDarkBaseLow">#ff3d3d3d</Color>
    <Color x:Key="ThemeDarkBaseMediumLow">#ff8a8a8a</Color>
    <Color x:Key="ThemeDarkChromeGray">#ff767676</Color>
    <Color x:Key="ThemeDarkBaseMedium">#ff9e9e9e</Color>
    <Color x:Key="ThemeDarkBaseMediumHigh">#ffc7c7c7</Color>
    <Color x:Key="ThemeDarkRegionColor">#ff1a1a1a</Color>

    <!-- ═══════════════════════════════════════════════════════════
         SEMANTIC UI BRUSHES
         Theme-aware: resolved via {DynamicResource} in views.
    ═══════════════════════════════════════════════════════════ -->

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BrushSurface"            Color="#ffffffff"/>
            <SolidColorBrush x:Key="BrushSurfaceAlt"         Color="#fff4f4f4"/>
            <SolidColorBrush x:Key="BrushSidebar"            Color="#ffebebeb"/>
            <SolidColorBrush x:Key="BrushCardBackground"     Color="#ffffffff"/>
            <SolidColorBrush x:Key="BrushBorderSubtle"       Color="#ffdedede"/>
            <SolidColorBrush x:Key="BrushAccent"             Color="#ff0f766e"/>

            <SolidColorBrush x:Key="BrushStatusDraftBg"      Color="#fffef3c7"/>
            <SolidColorBrush x:Key="BrushStatusDraftFg"      Color="#ff92400e"/>
            <SolidColorBrush x:Key="BrushStatusGeneratedBg"  Color="#ffd1fae5"/>
            <SolidColorBrush x:Key="BrushStatusGeneratedFg"  Color="#ff065f46"/>

            <SolidColorBrush x:Key="BrushStatusGenerated"    Color="#ff2e7d32"/>
            <SolidColorBrush x:Key="BrushStatusDraft"        Color="#fff9a825"/>

            <SolidColorBrush x:Key="BrushActionAdd"          Color="#ff2e7d32"/>
            <SolidColorBrush x:Key="BrushActionDelete"       Color="#ffc62828"/>
            <SolidColorBrush x:Key="BrushDefaultIndicator"   Color="Gold"/>
            <SolidColorBrush x:Key="BrushExpanderBorder"     Color="#ff8a8a8a"/>

            <!-- Drawn caption buttons (window chrome): subtle neutral hover/pressed,
                 matching native Win11 min/max button behavior. -->
            <SolidColorBrush x:Key="CaptionButtonBackground"  Color="#0f000000"/>
            <SolidColorBrush x:Key="CaptionButtonBorderBrush" Color="#0a000000"/>
            <SolidColorBrush x:Key="CaptionButtonForeground"  Color="#ff1a1a1a"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="BrushSurface"            Color="#ff242424"/>
            <SolidColorBrush x:Key="BrushSurfaceAlt"         Color="#ff2d2d2d"/>
            <SolidColorBrush x:Key="BrushSidebar"            Color="#ff202020"/>
            <SolidColorBrush x:Key="BrushCardBackground"     Color="#ff2d2d2d"/>
            <SolidColorBrush x:Key="BrushBorderSubtle"       Color="#ff3d3d3d"/>
            <SolidColorBrush x:Key="BrushAccent"             Color="#ff14b8a6"/>

            <SolidColorBrush x:Key="BrushStatusDraftBg"      Color="#ff42330a"/>
            <SolidColorBrush x:Key="BrushStatusDraftFg"      Color="#fffcd34d"/>
            <SolidColorBrush x:Key="BrushStatusGeneratedBg"  Color="#ff0d3b2e"/>
            <SolidColorBrush x:Key="BrushStatusGeneratedFg"  Color="#ff6ee7b7"/>

            <SolidColorBrush x:Key="BrushStatusGenerated"    Color="#ff66bb6a"/>
            <SolidColorBrush x:Key="BrushStatusDraft"        Color="#fffbc02d"/>

            <SolidColorBrush x:Key="BrushActionAdd"          Color="#ff66bb6a"/>
            <SolidColorBrush x:Key="BrushActionDelete"       Color="#ffef5350"/>
            <SolidColorBrush x:Key="BrushDefaultIndicator"   Color="Gold"/>
            <SolidColorBrush x:Key="BrushExpanderBorder"     Color="#ff6e6e6e"/>

            <!-- Drawn caption buttons (window chrome): subtle neutral hover/pressed,
                 matching native Win11 min/max button behavior. -->
            <SolidColorBrush x:Key="CaptionButtonBackground"  Color="#17ffffff"/>
            <SolidColorBrush x:Key="CaptionButtonBorderBrush" Color="#0fffffff"/>
            <SolidColorBrush x:Key="CaptionButtonForeground"  Color="#ffffffff"/>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
