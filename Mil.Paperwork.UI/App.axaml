<Application xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 x:Class="Mil.Paperwork.UI.App"
			 xmlns:local="using:Mil.Paperwork.UI"
			 xmlns:converters="using:Mil.Paperwork.UI.Converters"
			 RequestedThemeVariant="Default">

	<Application.DataTemplates>
		<local:ViewLocator/>
	</Application.DataTemplates>

	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="Assets/Colors.axaml"/>
				<ResourceInclude Source="Assets/Icons.axaml"/>
			</ResourceDictionary.MergedDictionaries>
			<x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>
			<converters:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
		</ResourceDictionary>
	</Application.Resources>

	<Application.Styles>

		<FluentTheme DensityStyle="Compact">
			<FluentTheme.Palettes>
				<ColorPaletteResources x:Key="Light"
					Accent="{StaticResource ThemeAccent}"
					AltHigh="White" AltLow="White" AltMedium="White" AltMediumHigh="White" AltMediumLow="White"
					BaseHigh="Black"
					BaseLow="{StaticResource ThemeLightBaseLow}"
					BaseMedium="{StaticResource ThemeLightBaseMedium}"
					BaseMediumHigh="{StaticResource ThemeLightBaseMediumHigh}"
					BaseMediumLow="{StaticResource ThemeLightBaseMediumLow}"
					ChromeAltLow="{StaticResource ThemeLightBaseMediumHigh}"
					ChromeBlackHigh="Black"
					ChromeBlackLow="{StaticResource ThemeLightBaseLow}"
					ChromeBlackMedium="{StaticResource ThemeLightBaseMediumHigh}"
					ChromeBlackMediumLow="{StaticResource ThemeLightBaseMedium}"
					ChromeDisabledHigh="{StaticResource ThemeLightBaseLow}"
					ChromeDisabledLow="{StaticResource ThemeLightBaseMedium}"
					ChromeGray="{StaticResource ThemeLightBaseMediumLow}"
					ChromeHigh="{StaticResource ThemeLightBaseLow}"
					ChromeLow="{StaticResource ThemeLightChromeLow}"
					ChromeMedium="{StaticResource ThemeLightChromeMedium}"
					ChromeMediumLow="{StaticResource ThemeLightChromeLow}"
					ChromeWhite="White"
					ListLow="{StaticResource ThemeLightChromeMedium}"
					ListMedium="{StaticResource ThemeLightBaseLow}"
					RegionColor="{StaticResource ThemeLightRegionColor}"/>
				<ColorPaletteResources x:Key="Dark"
					Accent="{StaticResource ThemeAccent}"
					AltHigh="Black" AltLow="Black" AltMedium="Black" AltMediumHigh="Black" AltMediumLow="Black"
					BaseHigh="White"
					BaseLow="{StaticResource ThemeDarkBaseLow}"
					BaseMedium="{StaticResource ThemeDarkBaseMedium}"
					BaseMediumHigh="{StaticResource ThemeDarkBaseMediumHigh}"
					BaseMediumLow="{StaticResource ThemeDarkBaseMediumLow}"
					ChromeAltLow="{StaticResource ThemeDarkBaseMediumHigh}"
					ChromeBlackHigh="Black"
					ChromeBlackLow="{StaticResource ThemeDarkBaseMediumHigh}"
					ChromeBlackMedium="Black"
					ChromeBlackMediumLow="Black"
					ChromeDisabledHigh="{StaticResource ThemeDarkBaseLow}"
					ChromeDisabledLow="{StaticResource ThemeDarkBaseMedium}"
					ChromeGray="{StaticResource ThemeDarkChromeGray}"
					ChromeHigh="{StaticResource ThemeDarkChromeGray}"
					ChromeLow="{StaticResource ThemeDarkChromeLow}"
					ChromeMedium="{StaticResource ThemeDarkChromeMedium}"
					ChromeMediumLow="{StaticResource ThemeDarkChromeMediumLow}"
					ChromeWhite="White"
					ListLow="{StaticResource ThemeDarkChromeMedium}"
					ListMedium="{StaticResource ThemeDarkBaseLow}"
					RegionColor="{StaticResource ThemeDarkRegionColor}"/>
			</FluentTheme.Palettes>
		</FluentTheme>

		<StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

		<StyleInclude Source="Styles/CommonStyles.axaml" />
		
		<StyleInclude Source="Styles/DataGridStyles.axaml" />

	</Application.Styles>
</Application>